#include <iostream>
#include <string>
using namespace std;

class Student
{
public:
    string studentName;
    string admissionNo;
    float percentage;

    void showDetails()
    {
        cout << "Student Name: " << studentName << endl;
        cout << "Admission No: " << admissionNo << endl;
        cout << "Percentage: " << percentage << "%" << endl;
        cout << "========================" << endl;
    }
};

int main()
{
    Student st1;
    st1.studentName = "Neha";
    st1.admissionNo = "A21";
    st1.percentage = 87.5;
    st1.showDetails();

    Student st2;
    st2.studentName = "Rohan";
    st2.admissionNo = "A22";
    st2.percentage = 93.2;
    st2.showDetails();

    Student st3;
    st3.studentName = "Meera";
    st3.admissionNo = "A23";
    st3.percentage = 81.8;
    st3.showDetails();

    return 0;
}
