#include <iostream>
using namespace std;
class student
{
 public:
        string name;
        string roll_no;
        float marks;

 void display()
 {
        cout<<"Name:"<<name<<endl;
        cout<<"Roll No:"<<roll_no<<endl;
        cout<<"Marks:"<<marks<<endl;
        cout<<"-----------------------"<<endl;
 }
};
 int main()
 {
        student s1;
        s1.name="arman";
        s1.roll_no="21";
        s1.marks=99.90;
        s1.display();

         student s2;
        s2.name="alya";
        s2.roll_no="45";
        s2.marks=87;
        s2.display();

         student s3;
        s3.name="om";
        s3.roll_no="18";
        s3.marks=90.20;
        s3.display();
        return 0;
 }
