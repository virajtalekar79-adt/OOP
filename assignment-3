#include <iostream>
#include <string>
using namespace std;

class product
{
private:
    string productName;
    int productId;
    int quantity;
    string category;

public:
    void input()
    {
        cout << "Product Name: ";
        cin >> productName;

        cout << "Product ID: ";
        cin >> productId;

        cout << "Quantity: ";
        cin >> quantity;

        cout << "Category: ";
        cin >> category;

        cout << "-----------------------" << endl << endl;
    }

    void display()
    {
        cout << "Product Name: " << productName << endl;
        cout << "Product ID: " << productId << endl;
        cout << "Quantity: " << quantity << endl;
        cout << "Category: " << category << endl;
        cout << "-------------------------" << endl;
    }
};

int main()
{
    product p1;
    product p2;
    product p3;

    p1.input();
    p2.input();
    p3.input();

    cout << "-----Product Details-----" << endl;

    p1.display();
    p2.display();
    p3.display();

    return 0;
}
