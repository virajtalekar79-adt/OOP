#include <iostream>
#include <string>
using namespace std;

class Book
{
public:
    string title;
    string author;
    int pages;
    float price;

    void displayBook()
    {
        cout << "Book Title: " << title << endl;
        cout << "Author: " << author << endl;
        cout << "Pages: " << pages << endl;
        cout << "Price: Rs. " << price << endl;
        cout << "-----------------------------" << endl;
    }
};

int main()
{
    Book b1;
    b1.title = "The men";
    b1.author = " thomsan ";
    b1.pages = 200;
    b1.price = 299.00;
    b1.displayBook();

    Book b2;
    b2.title = "Wings of Fire";
    b2.author = "A. P. J. Abdul Kalam";
    b2.pages = 180;
    b2.price = 250.50;
    b2.displayBook();

    Book b3;
    b3.title = "Rich Dad Poor Dad";
    b3.author = "Robert Kiyosaki";
    b3.pages = 300;
    b3.price = 399.00;
    b3.displayBook();

    return 0;
}
